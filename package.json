    "dompurify": "^3.2.4",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jose": "^6.0.8",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.4.1",
    "nodemailer": "^6.10.0",
    "picomatch": "^4.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "rehype-sanitize": "^6.0.0",
