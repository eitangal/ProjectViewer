# 64-character (32-byte) hex key for AES-256-GCM encryption of Publisher tokens & keys
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Min 32-character secret for signing session JWTs
JWT_SECRET_KEY=gitlens-portal-super-secret-jwt-signing-key-32-bytes!

# Root SysAdmin email seeded on startup
SYSADMIN_BOOTSTRAP_EMAIL=admin@gitlens-portal.local

# Server & Storage paths
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
PORTAL_BASE_URL=http://localhost:5173

# Optional SMTP Settings for passwordless emails (logs to console in dev mode if empty)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=noreply@gitlens-portal.local
