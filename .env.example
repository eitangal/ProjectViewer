# 64-character (32-byte) hex key for AES-256-GCM encryption of Publisher tokens & keys
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Min 32-character secret for signing session JWTs
JWT_SECRET_KEY=gitlens-portal-super-secret-jwt-signing-key-32-bytes!

# Root SysAdmin email seeded on startup
SYSADMIN_BOOTSTRAP_EMAIL=admin@gitlens-portal.local

# Server & Storage paths
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
PORTAL_BASE_URL=http://localhost:5173

# ==============================================================================
# Brevo (formerly Sendinblue) Transactional Email REST API Configuration
# ==============================================================================
# GitLens-Portal delivers passwordless Magic Links and 6-digit verification
# OTP codes directly via Brevo's HTTPS REST API (https://api.brevo.com/v3/smtp/email).
# In development mode without an API key, OTP codes & links are logged to console.
#
# HOW TO CONFIGURE BREVO API IN 3 STEPS:
# 1. Sign up or log in at https://app.brevo.com
# 2. Go to: Profile (top-right) -> "SMTP & API" -> "API Keys" tab
#    - Click "Generate a new API key", name it (e.g. GitLens-Portal), and copy it.
#    - Key format: xkeysib-... (do NOT use an SMTP key or account password)
# 3. Go to: "Senders & IP" -> "Senders" tab
#    - Ensure your sender email or domain is verified with Brevo (SPF/DKIM)
#    - Use this verified address for BREVO_SENDER_EMAIL
# ==============================================================================
BREVO_API_KEY=xkeysib-your-generated-brevo-api-key
BREVO_SENDER_EMAIL=noreply@your-verified-domain.com
BREVO_SENDER_NAME=GitLens Portal
